# Swift Package Manager 构建产物
.build/

# xcodebuild -derivedDataPath .build-xcode 的本地构建产物
.build-xcode/
DerivedData/
.swiftpm/

# Xcode 个人设置（共享工程和 scheme 仍提交）
xcuserdata/
*.xcuserstate

# 本地开发文档、设计稿与依赖设计稿的图标工具
/docs/
/design/
/scripts/build-icons.sh
AGENTS.md
/.agents/
/.codex/

# dist 仅提交可分发的软件包与校验文件
/dist/*
!/dist/OpenBy-*.dmg
!/dist/OpenBy-*.zip
!/dist/OpenBy-*.dmg.sha256
!/dist/OpenBy-*.zip.sha256

# 未打包应用、调试符号与归档中间产物
*.app/
*.xcarchive/
*.dSYM/

# 配置备份
*.bak

# 本地环境与签名凭据
.env
.env.*
!.env.example
*.p12
*.p8
*.mobileprovision
*.provisionprofile

# Python 图标工具缓存
__pycache__/
*.py[cod]

# 系统文件
.DS_Store

# 本地测试、性能基准及其运行入口
/Tests/
/Benchmarks/
/Sources/OpenByTestRunner/
/scripts/run-tests.sh
/scripts/check-window-layout.sh
/OpenBy.xcodeproj/xcshareddata/xcschemes/OpenByTestRunner.xcscheme
/OpenBy.xcodeproj/xcshareddata/xcschemes/OpenByBenchmark.xcscheme
